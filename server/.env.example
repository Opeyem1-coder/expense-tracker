# =====================================================
# server/.env  —  Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it's in .gitignore
# =====================================================

# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# JWT secret — make this long and random
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=7f8e9d0c1b2a3f4e5d6c7b8a9f0e1d2c3b4a5f6e7d8c9b0a1f2e3d4c5b6a7f8e9d0c1b2a3f4e5d6c7b8a9f0e1d2c

# Port the server runs on
PORT=5000

# Client URL (for CORS) — change in production
CLIENT_URL=http://localhost:5173
